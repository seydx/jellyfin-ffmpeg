Index: FFmpeg/ffbuild/common.mak b/ffbuild/common.mak
===================================================================
--- FFmpeg.orig/ffbuild/common.mak b/ffbuild/common.mak
+++ FFmpeg/ffbuild/common.mak b/ffbuild/common.mak
@@ -42,7 +42,8 @@ endif
 PREPEND = $(eval $(1) = $(patsubst %,$$(%), $(2)) $(value $(1)))
 
 # NASM requires -I path terminated with /
-IFLAGS     := -I. -I$(SRC_LINK)/
+# Use -iquote for current directory to avoid VERSION file conflicting with C++20 <version> header
+IFLAGS     := -iquote . -I$(SRC_LINK)/
 CPPFLAGS   := $(IFLAGS) $(CPPFLAGS)
 CFLAGS     += $(ECFLAGS)
 CCFLAGS     = $(CPPFLAGS) $(CFLAGS)
@@ -52,7 +53,8 @@ ASFLAGS    := $(CPPFLAGS) $(ASFLAGS)
 # Use PREPEND here so that later (target-dependent) additions to CPPFLAGS
 # end up in CXXFLAGS.
 $(call PREPEND,CXXFLAGS, CPPFLAGS)
-X86ASMFLAGS += $(IFLAGS:%=%/) -I$(<D)/ -Pconfig.asm
+# NASM doesn't support -iquote, so use explicit -I flags for assembly
+X86ASMFLAGS += -I. -I$(SRC_LINK)/ -I$(<D)/ -Pconfig.asm
 NVCCFLAGS  += $(IFLAGS)
 
 HOSTCCFLAGS = $(IFLAGS) $(HOSTCPPFLAGS) $(HOSTCFLAGS)
