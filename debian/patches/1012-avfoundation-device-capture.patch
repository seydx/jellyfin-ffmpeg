+#if AVF_HAS_SCREEN_CAPTURE_KIT
+/** SCK Frame Receiver — handles both video and audio output from SCStream */
+API_AVAILABLE(macos(12.3))
+@interface AVFSCKFrameReceiver : NSObject <SCStreamOutput>
+{
+    AVFContext* _context;
+}
+- (id)initWithContext:(AVFContext*)context;
+@end
+
+API_AVAILABLE(macos(12.3))
+@implementation AVFSCKFrameReceiver
+
+- (id)initWithContext:(AVFContext*)context
+{
+    if (self = [super init]) _context = context;
+    return self;
+}
+
+- (void)stream:(SCStream *)stream
+    didOutputSampleBuffer:(CMSampleBufferRef)sampleBuffer
+                   ofType:(SCStreamOutputType)type
+{
+    if (type == SCStreamOutputTypeScreen) {
+        // Only accept frames with actual image data (complete or started).
+        // SCK delivers idle/blank/suspended/stopped buffers without pixel data.
+        CFArrayRef attachmentsArray = CMSampleBufferGetSampleAttachmentsArray(sampleBuffer, false);
+        if (attachmentsArray && CFArrayGetCount(attachmentsArray) > 0) {
+            CFDictionaryRef dict = (CFDictionaryRef)CFArrayGetValueAtIndex(attachmentsArray, 0);
+            CFTypeRef statusValue = CFDictionaryGetValue(dict, SCStreamFrameInfoStatus);
+            if (statusValue) {
+                CFIndex status = 0;
+                if (CFNumberGetValue((CFNumberRef)statusValue, kCFNumberCFIndexType, &status)) {
+                    // SCFrameStatusComplete = 0, SCFrameStatusIdle = 1,
+                    // SCFrameStatusBlank = 2, SCFrameStatusSuspended = 3,
+                    // SCFrameStatusStarted = 4, SCFrameStatusStopped = 5
+                    if (status != SCFrameStatusComplete && status != SCFrameStatusStarted)
+                        return;
+                }
+            }
+        }
+
+        lock_frames(_context);
+        if (_context->current_frame != nil)
+            CFRelease(_context->current_frame);
+        _context->current_frame = (CMSampleBufferRef)CFRetain(sampleBuffer);
+        unlock_frames(_context);
+        ++_context->frames_captured;
+    }
+    else if (type == SCStreamOutputTypeAudio) {
+        lock_frames(_context);
+        if (_context->current_audio_frame != nil)
+            CFRelease(_context->current_audio_frame);
+        _context->current_audio_frame = (CMSampleBufferRef)CFRetain(sampleBuffer);
+        unlock_frames(_context);
+        ++_context->audio_frames_captured;
+    }
+}
+@end
+
+/* ---- synchronous SCK helpers ---- */
+
+API_AVAILABLE(macos(12.3))
+static SCShareableContent* avf_get_shareable_content_sync(AVFormatContext *s)
+{
+    __block SCShareableContent* result = nil;
+    __block NSError* blockError = nil;
+    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
+
+    [SCShareableContent getShareableContentExcludingDesktopWindows:YES
+                                             onScreenWindowsOnly:YES
+                                                completionHandler:^(SCShareableContent *content, NSError *error) {
+        result = [content retain];
+        blockError = [error retain];
+        dispatch_semaphore_signal(sem);
+    }];
+
+    dispatch_semaphore_wait(sem, DISPATCH_TIME_FOREVER);
+
+    if (blockError) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: failed to get shareable content: %s\n",
+               [[blockError localizedDescription] UTF8String]);
+        [blockError release];
+        [result release];
+        return nil;
+    }
+    return [result autorelease];
+}
+
+API_AVAILABLE(macos(12.3))
+static int avf_sck_start_capture_sync(AVFormatContext *s, SCStream *stream)
+{
+    __block NSError* blockError = nil;
+    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
+    [stream startCaptureWithCompletionHandler:^(NSError *error) {
+        blockError = [error retain];
+        dispatch_semaphore_signal(sem);
+    }];
+    dispatch_semaphore_wait(sem, DISPATCH_TIME_FOREVER);
+    if (blockError) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: failed to start capture: %s\n",
+               [[blockError localizedDescription] UTF8String]);
+        [blockError release];
+        return AVERROR_EXTERNAL;
+    }
+    return 0;
+}
+
+API_AVAILABLE(macos(12.3))
+static void avf_sck_stop_capture_sync(SCStream *stream)
+{
+    dispatch_semaphore_t sem = dispatch_semaphore_create(0);
+    [stream stopCaptureWithCompletionHandler:^(NSError *error) {
+        (void)error;
+        dispatch_semaphore_signal(sem);
+    }];
+    dispatch_semaphore_wait(sem, DISPATCH_TIME_FOREVER);
+}
+
+/* ---- SCK screen capture setup ---- */
+
+API_AVAILABLE(macos(12.3))
+static int avf_setup_sck_screen_capture(AVFormatContext *s, int screen_index)
+{
+    AVFContext *ctx = (AVFContext*)s->priv_data;
+
+    // 1. Get shareable content
+    SCShareableContent *shareableContent = avf_get_shareable_content_sync(s);
+    if (!shareableContent) return AVERROR_EXTERNAL;
+
+    NSArray<SCDisplay*> *displays = shareableContent.displays;
+    if (screen_index < 0 || screen_index >= (int)displays.count) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: display index %d out of range (0-%lu)\n",
+               screen_index, (unsigned long)(displays.count - 1));
+        return AVERROR(EINVAL);
+    }
+
+    SCDisplay *display = displays[screen_index];
+
+    // 2. Configure
+    SCContentFilter *filter = [[SCContentFilter alloc] initWithDisplay:display excludingWindows:@[]];
+    SCStreamConfiguration *config = [[SCStreamConfiguration alloc] init];
+
+    int captureWidth  = ctx->width > 0  ? ctx->width  : (int)display.width;
+    int captureHeight = ctx->height > 0 ? ctx->height : (int)display.height;
+    config.width  = captureWidth;
+    config.height = captureHeight;
+
+    if (ctx->framerate.num > 0)
+        config.minimumFrameInterval = CMTimeMake(ctx->framerate.den, ctx->framerate.num);
+
+    config.showsCursor = ctx->capture_cursor ? YES : NO;
+
+    // Mouse clicks (macOS 15.0+)
+    if (ctx->capture_mouse_clicks) {
+        if (__builtin_available(macOS 15.0, *)) {
+            config.showMouseClicks = YES;
+        } else {
+            av_log(s, AV_LOG_WARNING,
+                   "ScreenCaptureKit: showMouseClicks requires macOS 15.0+, ignoring\n");
+        }
+    }
+
+    // Pixel format: map AVPixelFormat → CVPixelFormatType via avf_pixel_formats[]
+    OSType pixelType = 0;
+    for (int i = 0; avf_pixel_formats[i].ff_id != AV_PIX_FMT_NONE; i++) {
+        if (ctx->pixel_format == avf_pixel_formats[i].ff_id) {
+            pixelType = avf_pixel_formats[i].avf_id;
+            break;
+        }
+    }
+    if (pixelType == 0) {
+        pixelType = kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+        ctx->pixel_format = AV_PIX_FMT_NV12;
+    }
+    config.pixelFormat = pixelType;
+
+    // 3. Audio configuration (macOS 13.0+)
+    if (ctx->capture_system_audio) {
+        if (__builtin_available(macOS 13.0, *)) {
+            config.capturesAudio = YES;
+
+            // Sample rate: 8000, 16000, 24000, 48000 (default 48000)
+            int sr = ctx->sck_audio_sample_rate;
+            if (sr != 8000 && sr != 16000 && sr != 24000 && sr != 48000)
+                sr = 48000;
+            config.sampleRate = sr;
+
+            // Channel count: 1 (mono) or 2 (stereo, default)
+            int ch = ctx->sck_audio_channels;
+            if (ch != 1 && ch != 2)
+                ch = 2;
+            config.channelCount = ch;
+
+            if (ctx->exclude_process_audio)
+                config.excludesCurrentProcessAudio = YES;
+            ctx->sck_audio_active = 1;
+            av_log(s, AV_LOG_INFO, "ScreenCaptureKit: system audio capture enabled (%dHz %s)\n",
+                   sr, ch == 1 ? "mono" : "stereo");
+        } else {
+            av_log(s, AV_LOG_WARNING,
+                   "ScreenCaptureKit: system audio requires macOS 13.0+, ignoring\n");
+        }
+    }
+
+    // 4. Create delegate + stream
+    ctx->sck_delegate = [[AVFSCKFrameReceiver alloc] initWithContext:ctx];
+
+    SCStream *stream = [[SCStream alloc] initWithFilter:filter configuration:config delegate:nil];
+
+    // Use separate serial queues for video and audio so that burst-y video
+    // callbacks cannot block or delay audio callbacks.  This mirrors how
+    // AVCaptureSession uses independent delegates for video and audio.
+    dispatch_queue_t video_queue = dispatch_queue_create("avf_sck_video", DISPATCH_QUEUE_SERIAL);
+    NSError *addError = nil;
+    [stream addStreamOutput:ctx->sck_delegate
+                       type:SCStreamOutputTypeScreen
+          sampleHandlerQueue:video_queue
+                      error:&addError];
+
+    if (!addError && ctx->sck_audio_active) {
+        if (__builtin_available(macOS 13.0, *)) {
+            dispatch_queue_t audio_queue = dispatch_queue_create("avf_sck_audio", DISPATCH_QUEUE_SERIAL);
+            [stream addStreamOutput:ctx->sck_delegate
+                               type:SCStreamOutputTypeAudio
+                  sampleHandlerQueue:audio_queue
+                              error:&addError];
+            dispatch_release(audio_queue);
+        }
+    }
+
+    [filter release];
+    [config release];
+    dispatch_release(video_queue);
+
+    if (addError) {
+        av_log(s, AV_LOG_ERROR, "ScreenCaptureKit: failed to add stream output: %s\n",
+               [[addError localizedDescription] UTF8String]);
+        [stream release];
+        [ctx->sck_delegate release];
+        ctx->sck_delegate = nil;
+        return AVERROR_EXTERNAL;
+    }
+
+    // 5. Start capture
+    int ret = avf_sck_start_capture_sync(s, stream);
+    if (ret < 0) {
+        [stream release];
+        [ctx->sck_delegate release];
+        ctx->sck_delegate = nil;
+        return ret;
+    }
+
+    // 6. Store
+    ctx->sck_stream    = stream;
+    ctx->sck_active    = 1;
+    ctx->width         = captureWidth;
+    ctx->height        = captureHeight;
+    ctx->video_is_screen = 1;
+
+    av_log(s, AV_LOG_INFO, "ScreenCaptureKit: capturing display %d at %dx%d\n",
+           screen_index, captureWidth, captureHeight);
+
+    return 0;
+}
+#endif
+
 static void destroy_context(AVFContext* ctx)
 {
+#if AVF_HAS_SCREEN_CAPTURE_KIT
+    if (ctx->sck_active) {
+        if (__builtin_available(macOS 12.3, *)) {
+            if (ctx->sck_stream) {
+                avf_sck_stop_capture_sync(ctx->sck_stream);
+                [ctx->sck_stream release];
+                ctx->sck_stream = NULL;
+            }
+            [ctx->sck_delegate release];
+            ctx->sck_delegate = NULL;
+        }
+        ctx->sck_active = 0;
+        ctx->sck_audio_active = 0;
+    }
+#endif
+
     [ctx->capture_session stopRunning];
 
     [ctx->capture_session release];
