# Maintainer: Vulkan-Shim-Loader for Jellyfin FFmpeg

_realname=vulkan-loader
pkgbase=mingw-w64-jellyfin-${_realname}
pkgname=${MINGW_PACKAGE_PREFIX}-jellyfin-${_realname}
pkgver=1.0.0
pkgrel=1
pkgdesc='Vulkan Shim Loader - stub library for static linking (mingw-w64)'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url='https://github.com/BtbN/Vulkan-Shim-Loader'
license=('spdx:Apache-2.0')
makedepends=(
    "${MINGW_PACKAGE_PREFIX}-cmake"
    "${MINGW_PACKAGE_PREFIX}-ninja"
    "${MINGW_PACKAGE_PREFIX}-cc"
    "${MINGW_PACKAGE_PREFIX}-jellyfin-vulkan-headers"
)
depends=(
    "${MINGW_PACKAGE_PREFIX}-jellyfin-vulkan-headers"
)
_commit="9657ca8e395ef16c79b57c8bd3f4c1aebb319137"
_commit_headers="v1.4.332"
source=(
    "${_realname}::git+https://github.com/BtbN/Vulkan-Shim-Loader.git#commit=${_commit}"
    "vulkan-headers::git+https://github.com/KhronosGroup/Vulkan-Headers.git#tag=${_commit_headers}"
)
sha256sums=('SKIP' 'SKIP')

export MINGW_TOOLCHAIN_PREFIX="${MINGW_PREFIX}"
export FF_MINGW_PREFIX="${MINGW_TOOLCHAIN_PREFIX}/ffbuild"

prepare() {
  # Copy Vulkan-Headers into the loader directory (required dependency)
  cp -r "${srcdir}/vulkan-headers" "${srcdir}/${_realname}/Vulkan-Headers"
}

build() {
  mkdir -p "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    ${MINGW_TOOLCHAIN_PREFIX}/bin/cmake.exe \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${FF_MINGW_PREFIX}" \
      -DCMAKE_BUILD_TYPE=Release \
      -DVULKAN_SHIM_IMPERSONATE=ON \
      ../${_realname}

  ${MINGW_TOOLCHAIN_PREFIX}/bin/cmake.exe --build .
}

check() {
  :
}

package() {
  cd "${srcdir}/build-${MSYSTEM}"

  DESTDIR="${pkgdir}" ${MINGW_TOOLCHAIN_PREFIX}/bin/cmake.exe --install .
}
