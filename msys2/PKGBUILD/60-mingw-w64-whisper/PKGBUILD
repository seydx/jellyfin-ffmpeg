# Maintainer: whisper.cpp integration for Jellyfin FFmpeg

_realname=whisper
pkgbase=mingw-w64-jellyfin-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-jellyfin-${_realname}")
pkgver=1.8.3
pkgrel=1
pkgdesc="Port of OpenAI's Whisper model in C/C++ (mingw-w64)"
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/ggml-org/whisper.cpp"
msys2_repository_url="https://github.com/ggml-org/whisper.cpp"
license=('spdx:MIT')
makedepends=(
    "${MINGW_PACKAGE_PREFIX}-cc"
    "${MINGW_PACKAGE_PREFIX}-cmake"
    "${MINGW_PACKAGE_PREFIX}-ninja"
    "${MINGW_PACKAGE_PREFIX}-pkgconf"
    "${MINGW_PACKAGE_PREFIX}-jellyfin-vulkan-headers"
    "${MINGW_PACKAGE_PREFIX}-jellyfin-shaderc"
    "${MINGW_PACKAGE_PREFIX}-jellyfin-opencl-headers"
)
depends=(
    "${MINGW_PACKAGE_PREFIX}-jellyfin-vulkan-loader"
    "${MINGW_PACKAGE_PREFIX}-jellyfin-opencl-icd"
)
_commit="2eeeba56e9edd762b4b38467bab96c2517163158"
source=("${_realname}::git+https://github.com/ggml-org/whisper.cpp.git#commit=${_commit}")
sha256sums=('SKIP')

export MINGW_TOOLCHAIN_PREFIX="${MINGW_PREFIX}"
export FF_MINGW_PREFIX="${MINGW_TOOLCHAIN_PREFIX}/ffbuild"

build() {
  # Use short build path to avoid Windows MAX_PATH issues
  local _build_dir="/c/whisper-build-${MSYSTEM}"
  mkdir -p "${_build_dir}" && cd "${_build_dir}"

  # Set paths to find installed dependencies
  export CMAKE_PREFIX_PATH="${FF_MINGW_PREFIX}"
  export PKG_CONFIG_PATH="${FF_MINGW_PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH}"
  export PATH="${FF_MINGW_PREFIX}/bin:${PATH}"

  echo "DEBUG: CMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH}"
  echo "DEBUG: PKG_CONFIG_PATH=${PKG_CONFIG_PATH}"
  echo "DEBUG: Checking for glslc in PATH:"
  which glslc || echo "WARNING: glslc not found in PATH"
  echo "DEBUG: Checking for Vulkan pkg-config:"
  pkg-config --exists vulkan && echo "SUCCESS: vulkan.pc found" || echo "WARNING: vulkan.pc not found"
  pkg-config --exists OpenCL && echo "SUCCESS: OpenCL.pc found" || echo "WARNING: OpenCL.pc not found"
  pkg-config --exists shaderc && echo "SUCCESS: shaderc.pc found" || echo "WARNING: shaderc.pc not found"

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
    ${MINGW_TOOLCHAIN_PREFIX}/bin/cmake.exe \
      -GNinja \
      -DCMAKE_INSTALL_PREFIX="${FF_MINGW_PREFIX}" \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_SHARED_LIBS=OFF \
      -DWHISPER_BUILD_TESTS=OFF \
      -DWHISPER_BUILD_EXAMPLES=OFF \
      -DWHISPER_BUILD_SERVER=OFF \
      -DWHISPER_USE_SYSTEM_GGML=OFF \
      -DGGML_CCACHE=OFF \
      -DGGML_OPENCL=ON \
      -DGGML_OPENCL_USE_ADRENO_KERNELS=OFF \
      -DGGML_VULKAN=ON \
      -DGGML_METAL=OFF \
      -DGGML_NATIVE=OFF \
      -DGGML_SSE42=ON \
      -DGGML_AVX=ON \
      -DGGML_F16C=ON \
      -DGGML_AVX2=ON \
      -DGGML_BMI2=ON \
      -DGGML_FMA=ON \
      "${srcdir}/${_realname}"

  ${MINGW_TOOLCHAIN_PREFIX}/bin/cmake.exe --build .
}

check() {
  :
}

package() {
  local _build_dir="/c/whisper-build-${MSYSTEM}"
  cd "${_build_dir}"

  DESTDIR="${pkgdir}" ${MINGW_TOOLCHAIN_PREFIX}/bin/cmake.exe --install .

  # Fix library prefix on Windows (ggml*.a -> libggml*.a)
  shopt -s nullglob
  for libfile in "${pkgdir}${FF_MINGW_PREFIX}"/lib/ggml*.a; do
    if [[ -f "${libfile}" ]]; then
      mv "${libfile}" "$(dirname "${libfile}")/lib$(basename "${libfile}")"
    fi
  done

  # Fix pkg-config file for correct linking order
  if [[ -f "${pkgdir}${FF_MINGW_PREFIX}"/lib/pkgconfig/whisper.pc ]]; then
    echo "=== whisper.pc BEFORE modifications ==="
    cat "${pkgdir}${FF_MINGW_PREFIX}"/lib/pkgconfig/whisper.pc
    echo "=== END ==="

    sed -i -e 's/^\(Libs:\).*$/\1 -L${libdir} -lwhisper/' "${pkgdir}${FF_MINGW_PREFIX}"/lib/pkgconfig/whisper.pc
    echo "Libs.private: -lggml -lggml-base -lggml-cpu -lggml-vulkan -lggml-opencl -lstdc++ -lomp" >> "${pkgdir}${FF_MINGW_PREFIX}"/lib/pkgconfig/whisper.pc
    echo "Requires: vulkan OpenCL" >> "${pkgdir}${FF_MINGW_PREFIX}"/lib/pkgconfig/whisper.pc

    echo "=== whisper.pc AFTER modifications ==="
    cat "${pkgdir}${FF_MINGW_PREFIX}"/lib/pkgconfig/whisper.pc
    echo "=== END ==="

    echo "=== Testing pkg-config ==="
    PKG_CONFIG_PATH="${pkgdir}${FF_MINGW_PREFIX}/lib/pkgconfig" pkg-config --exists --print-errors "whisper >= 1.7.5" && echo "SUCCESS: pkg-config can find whisper >= 1.7.5" || echo "FAILED: pkg-config cannot find whisper >= 1.7.5"
    PKG_CONFIG_PATH="${pkgdir}${FF_MINGW_PREFIX}/lib/pkgconfig" pkg-config --modversion whisper || echo "FAILED: cannot get version"
    echo "Testing with --static flag (as FFmpeg does):"
    PKG_CONFIG_PATH="${pkgdir}${FF_MINGW_PREFIX}/lib/pkgconfig" pkg-config --static --libs whisper || echo "FAILED: cannot get static libs"
    echo "=== END ==="
  fi

  # License
  install -Dm644 "${srcdir}/${_realname}/LICENSE" "${pkgdir}${FF_MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}

# template start; name=mingw-w64-splitpkg-wrappers; version=1.0;
# vim: set ft=bash :

# generate wrappers
for _name in "${pkgname[@]}"; do
  _short="package_${_name#${MINGW_PACKAGE_PREFIX}-jellyfin-}"
  _func="$(declare -f "${_short}")"
  eval "${_func/#${_short}/package_${_name}}"
done
# template end;
